# hesap-makinesi.
ilksayi = int(input("ilk sayıyı giriniz. "))
ikincisayi = int(input("ikinci sayıyı giriniz. "))
işlem = input("""Yapmak istediğiniz işlemi giriniz.
(Toplama: +, Çıkarma: -, Çarpma: *, Bölme: /)
""")

if işlem == "+":
    print("Sonuç: "+str(ilksayi+ikincisayi))

elif işlem == "-":
    print("Sonuç: "+str(ilksayi-ikincisayi))

elif işlem == "*":
    print("Sonuç: "+str(ilksayi*ikincisayi))

elif işlem == "/":
    print("Sonuç: "+str(ilksayi/ikincisayi))
